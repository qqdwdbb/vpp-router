+
+/* A drained interrupt queue cannot produce another completion interrupt.
+ * Retry only failed refills; the owning worker remains the sole ring writer.
+ * Main-thread interface mutations cannot interleave with this process scan.
+ */
+static uword
+tap_refill_retry_process (vlib_main_t *vm, vlib_node_runtime_t *node,
+                          vlib_frame_t *frame)
+{
+  vnet_main_t *vnm = vnet_get_main ();
+  while (1)
+    {
+      vlib_process_suspend (vm, 0.01);
+      tap_if_t *tif;
+      pool_foreach (tif, tap_main.interfaces)
+        {
+          if (!tif->admin_up)
+            continue;
+          tap_rxq_t *rxq;
+          vec_foreach (rxq, tif->rx_queues)
+            if (__atomic_load_n (&rxq->refill_pending, __ATOMIC_ACQUIRE))
+              vnet_hw_if_rx_queue_set_int_pending (vnm, rxq->queue_index);
+        }
+    }
+  return 0;
+}
+
+VLIB_REGISTER_NODE (tap_refill_retry_node) = {
+  .function = tap_refill_retry_process,
+  .type = VLIB_NODE_TYPE_PROCESS,
+  .name = "tap-refill-retry",
+};
