+static void
+rtl_rx_set_rss_hash(struct rtl_hw *hw, struct rtl_rx_desc *desc,
+		    struct rte_mbuf *mb)
+{
+	u32 rss_info;
+
+	if (!hw->EnableRss)
+		return;
+
+	switch (hw->HwSuppRxDescType) {
+	case RX_DESC_RING_TYPE_3:
+		rss_info = rte_le_to_cpu_16(((struct rtl_rx_descv3 *)desc)
+					    ->RxDescNormalDDWord2.HeaderInfo);
+		if (!(rss_info & RTL8125_RXS_RSS_L3_TYPE_MASK))
+			return;
+		break;
+	case RX_DESC_RING_TYPE_4:
+		rss_info = rte_le_to_cpu_32(((struct rtl_rx_descv4 *)desc)
+					    ->RxDescNormalDDWord1.RSSInfo);
+		if (!(rss_info & RTL8125_RXS_RSS_L3_TYPE_MASK_V4))
+			return;
+		break;
+	default:
+		return;
+	}
+
+	mb->hash.rss = rtl_get_rx_desc_hash(hw, desc);
+	mb->ol_flags |= RTE_MBUF_F_RX_RSS_HASH;
+}
