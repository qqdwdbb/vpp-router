+
+/* Collect at most four complete lines; flush at the ring end so a batch
+ * never wraps or leaves consumed entries pending when polling them again. */
+static inline void
+rtl_nc_rearm_consumed(struct rtl_rx_queue *rxq, uint16_t consumed,
+		      uint16_t *first, uint16_t *count)
+{
+	unsigned int per_line = rtl_nc_line / rxq->hw->RxDescLength;
+
+	if ((consumed + 1) % per_line)
+		return;
+	if (!*count)
+		*first = consumed + 1 - per_line;
+	*count += per_line;
+	if (*count >= 4 * per_line || consumed + 1 == rxq->nb_rx_desc) {
+		rtl_nc_rearm(rxq, *first, *count);
+		*count = 0;
+	}
 }
 
