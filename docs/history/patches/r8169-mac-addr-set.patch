+static int
+rtl_mac_addr_set(struct rte_eth_dev *dev, struct rte_ether_addr *mac_addr)
+{
+	struct rtl_adapter *adapter = RTL_DEV_PRIVATE(dev);
+	struct rtl_hw *hw = &adapter->hw;
+
+	if (mac_addr == NULL)
+		return -EINVAL;
+	if (!rte_is_valid_assigned_ether_addr(mac_addr))
+		return -EINVAL;
+
+	rte_ether_addr_copy(mac_addr, &dev->data->mac_addrs[0]);
+	rte_ether_addr_copy(mac_addr, (struct rte_ether_addr *)hw->mac_addr);
+	rtl_rar_set(hw, mac_addr->addr_bytes);
+	return 0;
+}
