+
+/* Keep empty polls outside the large ready-path stack frame. The first
+ * status snapshot is reused by the ready path; DMA synchronization is unchanged. */
+uint16_t
+rtl_recv_pkts(void *rx_queue, struct rte_mbuf **rx_pkts, uint16_t nb_pkts)
+{
+	struct rtl_rx_queue *rxq = rx_queue;
+	struct rtl_hw *hw = rxq->hw;
+	uintptr_t first_line = UINTPTR_MAX;
+	uint32_t opts1 = DescOwn;
+
+	RTE_ASSERT(RTL_R8(hw, ChipCmd) & CmdRxEnb);
+	if (nb_pkts) {
+		struct rtl_rx_desc *rxd = rtl_get_rxdesc(hw, rxq->hw_ring,
+						      rxq->rx_tail);
+		if (rtl_nc_dma) {
+			rtl_nc_sync(rxd, hw->RxDescLength, 1);
+			first_line = (uintptr_t)rxd & ~(uintptr_t)(rtl_nc_line - 1);
+		}
+		opts1 = rtl_rx_desc_opts1(hw, rxd);
+		if (!(opts1 & DescOwn))
+			return rtl_recv_pkts_ready(rx_queue, rx_pkts, nb_pkts,
+						   opts1, first_line);
+	}
+	/* Even an empty/zero-budget call must preserve deferred RDU handling. */
+	if (rxq->nb_rx_hold > rxq->rx_free_thresh) {
+		rte_wmb();
+		rtl_clear_rdu(hw, rxq->queue_id);
+		rxq->nb_rx_hold = 0;
+	}
+	return 0;
 }
 
