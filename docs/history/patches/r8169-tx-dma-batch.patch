+static inline void
+rtl_nc_tx_sync(struct rtl_tx_queue *txq, uint32_t first)
+{
+	uint32_t count;
+	uint16_t index, contiguous;
+
+	if (!rtl_nc_dma || !txq->hw->EnableTxNoClose)
+		return;
+	count = txq->tx_tail - first;
+	if (!count)
+		return;
+	index = first % txq->nb_tx_desc;
+	contiguous = RTE_MIN(count, (uint32_t)(txq->nb_tx_desc - index));
+	/* No-close leaves descriptor memory CPU-owned. Clean each touched
+	 * cache line once, including partial lines and a possible ring wrap. */
+	rtl_nc_sync_range(&txq->hw_ring[index],
+			  contiguous * sizeof(*txq->hw_ring), 0);
+	if (count > contiguous)
+		rtl_nc_sync_range(txq->hw_ring,
+				  (count - contiguous) * sizeof(*txq->hw_ring), 0);
+	/* One completion point orders all packet data and descriptors before
+	 * the NIC sees the new tail, even if descriptor lines evict early. */
+	rtl_nc_sync_complete();
+}
