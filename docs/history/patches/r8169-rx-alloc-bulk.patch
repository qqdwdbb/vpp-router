+/* Bound lookahead to eight descriptors and this ring segment. Keep the
+ * synchronized snapshot for the receive loop; never publish OWN here. */
+static inline unsigned int
+rtl_rx_scan_ready(struct rtl_rx_queue *rxq, uint16_t tail, uint16_t limit,
+		  uintptr_t *synced_line, uint16_t *scanned)
+{
+	struct rtl_hw *hw = rxq->hw;
+	unsigned int count = 0;
+
+	*scanned = 0;
+	while (*scanned < 8 && tail < rxq->nb_rx_desc && count < limit) {
+		struct rtl_rx_desc *rxd = rtl_get_rxdesc(hw, rxq->hw_ring, tail);
+		uint32_t opts1;
+
+		if (rtl_nc_dma) {
+			uintptr_t line = (uintptr_t)rxd &
+					 ~(uintptr_t)(rtl_nc_line - 1);
+			if (line != *synced_line) {
+				rtl_nc_sync(rxd, hw->RxDescLength, 1);
+				*synced_line = line;
+			}
+		}
+		opts1 = rtl_rx_desc_opts1(hw, rxd);
+		if (opts1 & DescOwn)
+			break;
+		if (!rtl_check_rx_desc_error(hw, opts1))
+			count++;
+		(*scanned)++;
+		tail++;
+	}
+	return count;
 }
 
