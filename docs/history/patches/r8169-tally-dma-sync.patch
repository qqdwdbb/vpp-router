+/* RTL8125 diagnostics are distinct hardware counters, not additive losses. */
+static const struct {
+	const char *name;
+	size_t offset;
+	size_t size;
+} rtl_tally_xstats[] = {
+#define RTL_TALLY_FIELD(field) {#field, offsetof(struct rtl_counters, field), \
+				 sizeof(((struct rtl_counters *)0)->field)}
+	RTL_TALLY_FIELD(rx_octets),
+	RTL_TALLY_FIELD(tx_octets),
+	RTL_TALLY_FIELD(tx_pause_on),
+	RTL_TALLY_FIELD(tx_pause_off),
+	RTL_TALLY_FIELD(tx_pause_all),
+	RTL_TALLY_FIELD(rx_mac_missed),
+	RTL_TALLY_FIELD(rx_tcam_dropped),
+	RTL_TALLY_FIELD(rx_mac_error),
+	RTL_TALLY_FIELD(rx_frame_too_long),
+	RTL_TALLY_FIELD(rx_runt),
+	RTL_TALLY_FIELD(rx_pause_on),
+	RTL_TALLY_FIELD(rx_pause_off),
+	RTL_TALLY_FIELD(rx_pause_all),
+	RTL_TALLY_FIELD(tdu),
+	RTL_TALLY_FIELD(rdu),
+#undef RTL_TALLY_FIELD
+};
+
+static int
+rtl_xstats_get_names(struct rte_eth_dev *dev,
+		struct rte_eth_xstat_name *names, unsigned int size)
+{
+	struct rtl_adapter *adapter = RTL_DEV_PRIVATE(dev);
+	unsigned int count = rtl_is_8125(&adapter->hw) ? RTE_DIM(rtl_tally_xstats) : 0;
+	unsigned int i;
+
+	if (!names || size < count)
+		return count;
+	for (i = 0; i < count; i++)
+		snprintf(names[i].name, sizeof(names[i].name), "%s", rtl_tally_xstats[i].name);
+	return count;
+}
+
+static int
+rtl_xstats_get(struct rte_eth_dev *dev, struct rte_eth_xstat *stats, unsigned int size)
+{
+	struct rtl_adapter *adapter = RTL_DEV_PRIVATE(dev);
+	struct rtl_hw *hw = &adapter->hw;
+	struct rte_eth_stats basic = {0};
+	unsigned int count = rtl_is_8125(hw) ? RTE_DIM(rtl_tally_xstats) : 0;
+	unsigned int i;
+	int ret;
+
+	if (!stats || size < count || !count)
+		return count;
+	ret = rtl_get_tally_stats(hw, &basic);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		u64 value = 0;
+		memcpy(&value, (const char *)hw->tally_vaddr + rtl_tally_xstats[i].offset,
+		       rtl_tally_xstats[i].size);
+		stats[i].id = i;
+		stats[i].value = rtl_tally_xstats[i].size == sizeof(u64) ?
+			rte_le_to_cpu_64(value) : rte_le_to_cpu_32((u32)value);
+	}
+	return count;
 }
 
