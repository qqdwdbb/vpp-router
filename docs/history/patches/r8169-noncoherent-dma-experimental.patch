+/* Publish only cache lines entirely consumed by software. A per-descriptor
+ * writeback could overwrite status in a neighbouring NIC-owned descriptor. */
 static void
+rtl_nc_rearm(struct rtl_rx_queue *rxq, uint16_t consumed)
+{
+	struct rtl_hw *hw = rxq->hw;
+	unsigned int per_line = rtl_nc_line / hw->RxDescLength;
+	unsigned int first, i;
+	if ((consumed + 1) % per_line)
+		return;
+	first = consumed + 1 - per_line;
+	for (i = first; i <= consumed; i++) {
+		struct rte_mbuf *mb = rxq->sw_ring[i].mbuf;
+		rtl_nc_sync((char *)mb->buf_addr + RTE_PKTMBUF_HEADROOM, hw->rx_buf_sz, 1);
+		rtl_map_to_asic(hw, rtl_get_rxdesc(hw, rxq->hw_ring, i),
+			rte_cpu_to_le_64(rte_mbuf_data_iova_default(mb)));
+	}
+	rtl_nc_sync(rtl_get_rxdesc(hw, rxq->hw_ring, first), rtl_nc_line, 0);
+}
