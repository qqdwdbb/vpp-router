+/* Isolated RK3588 experiment; enable only after kernel coherence probing. */
+static int rtl_nc_dma;
+static unsigned int rtl_nc_line;
+
+static void
+rtl_nc_init(void)
+{
+#if defined(RTE_ARCH_ARM64)
+	const char *value = getenv("R8169_DMA_NONCOHERENT");
+	uint64_t ctr;
+	if (!value || strcmp(value, "1"))
+		return;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r" (ctr));
+	rtl_nc_line = 4U << ((ctr >> 16) & 15);
+	rtl_nc_dma = 1;
+#endif
+}
+
+static inline void
+rtl_nc_sync(const void *address, size_t length, int invalidate)
+{
+#if defined(RTE_ARCH_ARM64)
+	uintptr_t start, end;
+	if (!rtl_nc_dma || !length)
+		return;
+	start = (uintptr_t)address & ~(uintptr_t)(rtl_nc_line - 1);
+	end = (uintptr_t)address + length;
+	for (; start < end; start += rtl_nc_line) {
+		if (invalidate)
+			__asm__ volatile("dc civac, %0" :: "r" (start) : "memory");
+		else
+			__asm__ volatile("dc cvac, %0" :: "r" (start) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+#else
+	RTE_SET_USED(address);
+	RTE_SET_USED(length);
+	RTE_SET_USED(invalidate);
+#endif
+}
 
