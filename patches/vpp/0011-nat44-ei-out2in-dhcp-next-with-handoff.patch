+/* With a worker configured, packets arrive from the handoff feature, which has
+ * already consumed this node's feature entry. Reading the arc again runs past the
+ * end of the chain and yields an index that is not a next of this node. */
+static_always_inline u32
+nat44_ei_out2in_dhcp_next (vlib_buffer_t *b)
+{
+  u32 next;
+  if (vlib_num_workers ())
+    return NAT44_EI_OUT2IN_NEXT_LOOKUP;
+  vnet_feature_next (&next, b);
+  return next;
+}
