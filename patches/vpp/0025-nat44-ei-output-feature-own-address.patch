--- a/src/plugins/nat/nat44-ei/nat44_ei_in2out.c
+++ b/src/plugins/nat/nat44-ei/nat44_ei_in2out.c
@@ -271,6 +271,17 @@
 }
 
 static_always_inline int
+nat44_ei_is_pool_address (nat44_ei_main_t *nm, ip4_address_t addr)
+{
+  nat44_ei_address_t *ap;
+
+  vec_foreach (ap, nm->addresses)
+    if (ap->addr.as_u32 == addr.as_u32)
+      return 1;
+  return 0;
+}
+
+static_always_inline int
 nat44_ei_not_translate_output_feature (nat44_ei_main_t *nm, ip4_header_t *ip0,
 				       u32 proto0, u16 src_port, u16 dst_port,
 				       u32 thread_index, u32 sw_if_index)
@@ -285,6 +296,13 @@
   if (!clib_bihash_search_8_8 (&nm->out2in, &kv0, &value0))
     return 1;
 
+  /* Sent by VPP itself from an outside address, such as the reply to a ping
+   * of the router or an ICMP error it raises: no inside host has that
+   * source, so it needs no translation. Translating it would give the reply
+   * a new ICMP identifier or port, which the peer drops. */
+  if (nat44_ei_is_pool_address (nm, ip0->src_address))
+    return 1;
+
   /* dst NAT check */
   init_nat_k (&kv0, ip0->dst_address, dst_port,
 	      ip4_fib_table_get_index_for_sw_if_index (sw_if_index), proto0);
