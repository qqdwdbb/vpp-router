--- a/src/plugins/nat/nat44-ei/nat44_ei_inlines.h
+++ b/src/plugins/nat/nat44-ei/nat44_ei_inlines.h
@@ -234,4 +234,26 @@
   return 0;
 }
 
+/* A packet from a TAP with checksum offload, Linux's own TCP or UDP, carries
+ * in its L4 checksum field only the uncomplemented sum of the pseudo-header;
+ * the TAP or the NIC adds the L4 bytes when it sends it. */
+static_always_inline int
+nat44_ei_l4_csum_is_partial (vlib_buffer_t *b)
+{
+  return (b->flags & VNET_BUFFER_F_OFFLOAD) &&
+	 (vnet_buffer (b)->oflags & (VNET_BUFFER_OFFLOAD_F_TCP_CKSUM |
+				     VNET_BUFFER_OFFLOAD_F_UDP_CKSUM));
+}
+
+/* Such a field takes only the address change, the opposite way round to a
+ * complete checksum; ports and the MSS option are L4 bytes the device sums
+ * itself. Zero is a sum there, not "no UDP checksum". */
+static_always_inline u16
+nat44_ei_partial_l4_csum (u16 field, u32 old_addr, u32 new_addr)
+{
+  ip_csum_t sum = field;
+  sum = ip_csum_update (sum, new_addr, old_addr, ip4_header_t, src_address);
+  return ip_csum_fold (sum);
+}
