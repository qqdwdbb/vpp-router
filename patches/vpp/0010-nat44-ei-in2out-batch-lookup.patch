+
+/* Resolve the fast path's session lookups before translating the frame.
+ * Each group walks bucket -> key/value page -> session in lock step, so one
+ * memory access per stage is outstanding for every packet instead of three
+ * consecutive stalls per packet. The fast path neither adds nor removes
+ * sessions, and the main thread only changes the table under the barrier, so
+ * the results stay valid until this node returns. */
+#define NAT44_EI_I2O_LOOKUP_GROUP 16
+
+static_always_inline void
+nat44_ei_in2out_batch_lookup (nat44_ei_main_t *nm, vlib_buffer_t **b, u32 n,
+			      u32 thread_index, int is_output_feature,
+			      u64 *values, u8 *misses)
+{
+  nat44_ei_main_per_thread_data_t *tnm = &nm->per_thread_data[thread_index];
+
+  for (u32 off = 0; off < n; off += NAT44_EI_I2O_LOOKUP_GROUP)
+    {
+      clib_bihash_kv_8_8_t kv[NAT44_EI_I2O_LOOKUP_GROUP];
+      u64 hash[NAT44_EI_I2O_LOOKUP_GROUP];
+      u32 n_group = clib_min (n - off, NAT44_EI_I2O_LOOKUP_GROUP);
+
+      for (u32 i = 0; i < n_group; i++)
+	{
+	  vlib_buffer_t *b0 = b[off + i];
+	  u32 offset =
+	    is_output_feature ? vnet_buffer (b0)->ip.reass.save_rewrite_length :
+				0;
+	  ip4_header_t *ip0 =
+	    (ip4_header_t *) ((u8 *) vlib_buffer_get_current (b0) + offset);
+	  u32 fib_index =
+	    vec_elt (nm->ip4_main->fib_index_by_sw_if_index,
+		     vnet_buffer (b0)->sw_if_index[VLIB_RX]);
+
+	  init_nat_k (&kv[i], ip0->src_address,
+		      vnet_buffer (b0)->ip.reass.l4_src_port, fib_index,
+		      ip_proto_to_nat_proto (ip0->protocol));
+	  hash[i] = clib_bihash_hash_8_8 (&kv[i]);
+	  clib_bihash_prefetch_bucket_8_8 (&nm->in2out, hash[i]);
+	}
+
+      for (u32 i = 0; i < n_group; i++)
+	clib_bihash_prefetch_data_8_8 (&nm->in2out, hash[i]);
+
+      for (u32 i = 0; i < n_group; i++)
+	{
+	  clib_bihash_kv_8_8_t value;
+
+	  misses[off + i] = clib_bihash_search_inline_2_with_hash_8_8 (
+			      &nm->in2out, hash[i], &kv[i], &value) != 0;
+	  if (PREDICT_TRUE (!misses[off + i]))
+	    {
+	      values[off + i] = value.value;
+	      CLIB_PREFETCH (tnm->sessions +
+			       nat_value_get_session_index (&value),
+			     2 * CLIB_CACHE_LINE_BYTES, STORE);
+	    }
+	}
+    }
 }
 
