+++ b/src/plugins/nat/nat44-ed/nat44_ed.c
@@ -268,7 +268,7 @@
 	}
 
       fib_index = ip4_fib_table_get_index_for_sw_if_index (i->sw_if_index);
-      if (fib_index != ap->fib_index)
+      if (ap->fib_index != ~0 && fib_index != ap->fib_index)
 	{
 	  continue;
 	}
@@ -315,7 +315,7 @@
 
   vec_foreach (ap, sm->addresses)
     {
-      if (fib_index != ap->fib_index)
+      if (ap->fib_index != ~0 && fib_index != ap->fib_index)
 	{
 	  continue;
 	}
@@ -525,6 +525,8 @@
 
   ap->addr_len = ~0;
   ap->fib_index = ~0;
+  /* Not bound to an interface until one that has the address is outside. */
+  ap->sw_if_index = ~0;
   ap->addr = *addr;
 
   if (vrf_id != ~0)
@@ -3472,7 +3474,7 @@
 	    ip4_fib_table_get_index_for_sw_if_index (sw_if_index);
 	  vec_foreach (ap, sm->addresses)
 	    {
-	      if ((fib_index == ap->fib_index) &&
+	      if ((ap->fib_index == ~0 || fib_index == ap->fib_index) &&
 		  (address->as_u32 == ap->addr.as_u32))
 		{
 		  if (!is_delete)
@@ -3490,6 +3492,7 @@
 		  else
 		    {
 		      ap->addr_len = ~0;
+		      ap->sw_if_index = ~0;
 		    }
 		  break;
 		}
