+++ b/src/plugins/nat/nat44-ed/nat44_ed.c
@@ -70,7 +70,9 @@
   .arc_name = "ip4-unicast",
   .node_name = "nat-pre-in2out",
   .runs_after = VNET_FEATURES ("acl-plugin-in-ip4-fa",
-			       "ip4-sv-reassembly-feature"),
+			       "ip4-sv-reassembly-feature",
+			       "dns-intercept-ip4",
+			       "abf-input-ip4"),
 };
