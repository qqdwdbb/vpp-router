+  /* RX interrupts come on an ibverbs completion channel: rx_intr_disable
+     consumes and acks the event, a read() of the fd does not */
+  u32 int_ack_by_disable : 1;
 } dpdk_driver_t;
 
 dpdk_driver_t *dpdk_driver_find (const char *name, const char **desc);
@@ -145,6 +148,7 @@
     u16 disable_tx_checksum_offload : 1;
     u16 disable_rss : 1;
     u16 disable_rx_scatter : 1;
+    u16 int_ack_by_disable : 1;
     u16 n_rx_queues;
     u16 n_tx_queues;
     u16 n_rx_desc;
