nat44-ei: record the receiving thread in output handoff

With output-feature NAT, every packet of one inside address goes to that
user's worker, which then also runs the output ACL, the remaining output
features and the TX. Record the thread that ran the handoff in
vnet_buffer2 (b)->unused[4] as thread index + 1, so a later output feature
(the nat-ei-context plugin's return handoff) can send translated packets
back to the receiving thread. The field is otherwise unused; translation,
worker selection and queue behaviour are unchanged.

--- a/src/plugins/nat/nat44-ei/nat44_ei_handoff.c
+++ b/src/plugins/nat/nat44-ei/nat44_ei_handoff.c
@@ -54,6 +54,11 @@
   return s;
 }
 
+/* Output handoff records the receiving thread (+1, 0 = unknown) for the
+ * nat-ei-context plugin, which can return translated packets to that thread
+ * for the rest of the output arc. The slot is otherwise unused. */
+#define NAT44_EI_RX_THREAD(b) (vnet_buffer2 (b)->unused[4])
+
 static inline uword
 nat44_ei_worker_handoff_fn_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 				   vlib_frame_t *frame, u8 is_output,
@@ -107,6 +112,10 @@
 	  iph_offset1 = vnet_buffer (b[1])->ip.save_rewrite_length;
 	  iph_offset2 = vnet_buffer (b[2])->ip.save_rewrite_length;
 	  iph_offset3 = vnet_buffer (b[3])->ip.save_rewrite_length;
+	  NAT44_EI_RX_THREAD (b[0]) = thread_index + 1;
+	  NAT44_EI_RX_THREAD (b[1]) = thread_index + 1;
+	  NAT44_EI_RX_THREAD (b[2]) = thread_index + 1;
+	  NAT44_EI_RX_THREAD (b[3]) = thread_index + 1;
 	}
 
       ip0 =
@@ -195,7 +204,10 @@
       ip4_header_t *ip0;
 
       if (is_output)
-	iph_offset0 = vnet_buffer (b[0])->ip.save_rewrite_length;
+	{
+	  iph_offset0 = vnet_buffer (b[0])->ip.save_rewrite_length;
+	  NAT44_EI_RX_THREAD (b[0]) = thread_index + 1;
+	}
 
       ip0 =
 	(ip4_header_t *) ((u8 *) vlib_buffer_get_current (b[0]) + iph_offset0);
