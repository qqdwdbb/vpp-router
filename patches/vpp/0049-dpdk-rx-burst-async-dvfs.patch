@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#include "dvfs.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/eventfd.h>
+
+/* Single explicitly selected CPUFreq policy. All its workers share one lease. */
+dpdk_dvfs_slot_t *dpdk_dvfs_slots;
+int dpdk_dvfs_event_fd = -1;
+static dpdk_dvfs_slot_t *slots;
+static unsigned n_slots, boost, idle, original;
+static int min_fd = -1, stopping;
+static pthread_t controller;
+static pthread_mutex_t stats_lock = PTHREAD_MUTEX_INITIALIZER;
+static dpdk_dvfs_stats_t stats;
+
+static int
+read_khz (int fd, unsigned *value)
+{
+  char buf[64], *end;
+  ssize_t n = pread (fd, buf, sizeof (buf) - 1, 0);
+  if (n <= 0)
+    return n < 0 ? errno : EIO;
+  buf[n] = 0;
+  errno = 0;
+  unsigned long v = strtoul (buf, &end, 10);
+  if (errno || end == buf || v == 0 || v > UINT_MAX)
+    return EINVAL;
+  *value = v;
+  return 0;
+}
+
+static int
+write_floor (unsigned value)
+{
+  char buf[32];
+  int n = snprintf (buf, sizeof (buf), "%u\n", value);
+  ssize_t written = pwrite (min_fd, buf, n, 0);
+  return written == n ? 0 : written < 0 ? errno : EIO;
+}
+
+static int
+open_attribute (const char *directory, const char *name, int flags)
+{
+  char path[PATH_MAX];
+  int length = snprintf (path, sizeof (path), "%s/%s", directory, name);
+  if (length < 0 || (size_t) length >= sizeof (path))
+    {
+      errno = ENAMETOOLONG;
+      return -1;
+    }
+  return open (path, flags | O_CLOEXEC);
+}
+
+static void *
+control_loop (void *unused)
+{
+  (void) unused;
+  dpdk_dvfs_sample_t sample = { 0 };
+  int active = 0;
+  struct pollfd event = { .fd = dpdk_dvfs_event_fd, .events = POLLIN };
+  while (!__atomic_load_n (&stopping, __ATOMIC_ACQUIRE))
+    {
+      uint64_t now = dpdk_dvfs_now (), last = 0, first = UINT64_MAX;
+      for (unsigned i = 0; i < n_slots; ++i)
+        {
+          uint64_t t = __atomic_load_n (&slots[i].last, __ATOMIC_ACQUIRE);
+          if (t && (t > now || now - t < DPDK_DVFS_HOLD_NS))
+            {
+              if (t > last)
+                last = t;
+              uint64_t f = __atomic_load_n (&slots[i].first, __ATOMIC_RELAXED);
+              if (f < first)
+                first = f;
+            }
+        }
+      if (last && !active)
+        {
+          sample = (dpdk_dvfs_sample_t) { .trigger = first, .wake = dpdk_dvfs_now () };
+          sample.write_begin = dpdk_dvfs_now ();
+          sample.error = write_floor (boost);
+          sample.write_end = dpdk_dvfs_now ();
+          /* Even a failed request owns a lease, so it is not retried per burst. */
+          active = 1;
+          pthread_mutex_lock (&stats_lock);
+          stats.active = 1;
+          stats.boosts++;
+          pthread_mutex_unlock (&stats_lock);
+        }
+      if (active && last)
+        sample.latest = last;
+      if (active && !last)
+        {
+          int err = write_floor (idle);
+          if (!sample.error)
+            sample.error = err;
+          sample.released = dpdk_dvfs_now ();
+          pthread_mutex_lock (&stats_lock);
+          stats.samples[stats.count++ % DPDK_DVFS_SAMPLES] = sample;
+          stats.releases++;
+          stats.failures += sample.error != 0;
+          stats.active = 0;
+          pthread_mutex_unlock (&stats_lock);
+          active = 0;
+        }
+      /* Sleep until lease expiry or a new episode. Requests during the lease
+       * extend it via slot timestamps; no frequency sampling is needed. */
+      struct timespec timeout, *wait = 0;
+      if (active)
+        {
+          now = dpdk_dvfs_now ();
+          uint64_t deadline = last + DPDK_DVFS_HOLD_NS;
+          uint64_t ns = deadline > now ? deadline - now : 0;
+          timeout = (struct timespec) { .tv_sec = ns / 1000000000ULL,
+                                       .tv_nsec = ns % 1000000000ULL };
+          wait = &timeout;
+        }
+      int rv = ppoll (&event, 1, wait, 0);
+      if (rv > 0 && (event.revents & POLLIN))
+        {
+          uint64_t value;
+          ssize_t ignored = read (event.fd, &value, sizeof (value));
+          (void) ignored;
+        }
+    }
+  return 0;
+}
+
+void
+dpdk_dvfs_snapshot (dpdk_dvfs_stats_t *out)
+{
+  pthread_mutex_lock (&stats_lock);
+  *out = stats;
+  pthread_mutex_unlock (&stats_lock);
+}
+
+int
+dpdk_dvfs_stop (void)
+{
+  if (!slots)
+    return 0;
+  dpdk_dvfs_slots = 0;
+  __atomic_store_n (&stopping, 1, __ATOMIC_RELEASE);
+  dpdk_dvfs_wake ();
+  pthread_join (controller, 0);
+  pthread_mutex_lock (&stats_lock);
+  stats.active = 0;
+  pthread_mutex_unlock (&stats_lock);
+  int err = write_floor (original);
+  close (min_fd);
+  close (dpdk_dvfs_event_fd);
+  free (slots);
+  slots = 0;
+  dpdk_dvfs_event_fd = -1;
+  return err;
+}
+
+int
+dpdk_dvfs_start (const char *directory, unsigned idle_khz, unsigned boost_khz,
+                 const unsigned char *enabled, unsigned n_threads)
+{
+  if (slots)
+    return EBUSY;
+  int err;
+  unsigned minimum = 0, maximum = 0;
+  int hw_min = open_attribute (directory, "cpuinfo_min_freq", O_RDONLY);
+  int max = open_attribute (directory, "scaling_max_freq", O_RDONLY);
+  if (hw_min < 0 || max < 0)
+    {
+      err = errno;
+      if (hw_min >= 0) close (hw_min);
+      if (max >= 0) close (max);
+      return err;
+    }
+  err = read_khz (hw_min, &minimum);
+  if (!err) err = read_khz (max, &maximum);
+  close (hw_min);
+  close (max);
+  if (err) return err;
+  if (idle_khz < minimum || idle_khz > boost_khz ||
+      boost_khz > maximum || !n_threads)
+    return EINVAL;
+  min_fd = open_attribute (directory, "scaling_min_freq", O_RDWR);
+  dpdk_dvfs_event_fd = eventfd (0, EFD_NONBLOCK | EFD_CLOEXEC);
+  if (min_fd < 0 || dpdk_dvfs_event_fd < 0)
+    { err = errno; goto fail; }
+  err = read_khz (min_fd, &original);
+  if (err) goto fail;
+  if (posix_memalign ((void **) &slots, 64, sizeof (*slots) * n_threads))
+    { slots = 0; err = ENOMEM; goto fail; }
+  memset (slots, 0, sizeof (*slots) * n_threads);
+  for (unsigned i = 0; i < n_threads; ++i)
+    slots[i].enabled = enabled[i];
+  n_slots = n_threads;
+  boost = boost_khz;
+  idle = idle_khz;
+  stopping = 0;
+  memset (&stats, 0, sizeof (stats));
+  stats.idle_khz = idle;
+  stats.boost_khz = boost;
+  stats.original_khz = original;
+  err = write_floor (idle);
+  if (err) goto fail;
+  /* Never inherit the packet threads' possible RT scheduling policy. */
+  pthread_attr_t attr;
+  pthread_attr_init (&attr);
+  pthread_attr_setinheritsched (&attr, PTHREAD_EXPLICIT_SCHED);
+  pthread_attr_setschedpolicy (&attr, SCHED_OTHER);
+  struct sched_param sp = { .sched_priority = 0 };
+  pthread_attr_setschedparam (&attr, &sp);
+  err = pthread_create (&controller, &attr, control_loop, 0);
+  pthread_attr_destroy (&attr);
+  if (err)
+    { write_floor (original); goto fail; }
+  pthread_setname_np (controller, "dpdk-dvfs");
+  dpdk_dvfs_slots = slots;
+  return 0;
+fail:
+  if (min_fd >= 0) close (min_fd);
+  if (dpdk_dvfs_event_fd >= 0) close (dpdk_dvfs_event_fd);
+  free (slots);
+  slots = 0;
+  dpdk_dvfs_event_fd = -1;
+  return err;
+}
