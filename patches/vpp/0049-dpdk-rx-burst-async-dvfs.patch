+/* SPDX-License-Identifier: Apache-2.0 */
+#include <vlib/vlib.h>
+#include <vlib/threads.h>
+#include <dpdk/device/dvfs.h>
+#include <ctype.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+static char selected_policy[32];
+
+static clib_error_t *
+dvfs_set (vlib_main_t *vm, unformat_input_t *input,
+          vlib_cli_command_t *cmd)
+{
+  (void) cmd;
+  u8 *policy = 0;
+  u32 idle, boost;
+  if (unformat (input, "disable") && unformat_check_input (input) == UNFORMAT_END_OF_INPUT)
+    {
+      vlib_worker_thread_barrier_sync (vm);
+      int err = dpdk_dvfs_stop ();
+      vlib_worker_thread_barrier_release (vm);
+      if (err)
+        return clib_error_return (0, "restore floor: %s", strerror (err));
+      selected_policy[0] = 0;
+      return 0;
+    }
+  int parsed = unformat (input, "policy %s idle %u boost %u", &policy, &idle, &boost);
+  if (!parsed ||
+      unformat_check_input (input) != UNFORMAT_END_OF_INPUT)
+    {
+      vec_free (policy);
+      return clib_error_return (0, "expected policy policyN idle <kHz> boost <kHz> | disable");
+    }
+  int valid = vec_len (policy) > 7 && vec_len (policy) < sizeof (selected_policy) &&
+    !strncmp ((char *) policy, "policy", 6);
+  for (u32 i = 6; valid && i + 1 < vec_len (policy); ++i)
+    valid = isdigit (policy[i]);
+  if (!valid)
+    {
+      vec_free (policy);
+      return clib_error_return (0, "expected policyN");
+    }
+  char path[256];
+  snprintf (path, sizeof (path), "/sys/devices/system/cpu/cpufreq/%s/related_cpus", policy);
+  FILE *f = fopen (path, "r");
+  if (!f)
+    {
+      vec_free (policy);
+      return clib_error_return (0, "open related_cpus: %s", strerror (errno));
+    }
+  unsigned n = vlib_thread_main.n_vlib_mains, matched = 0, cpu;
+  u8 *enabled = 0;
+  vec_validate (enabled, n - 1);
+  while (fscanf (f, "%u", &cpu) == 1)
+    for (unsigned i = 0; i < n; ++i)
+      if (vlib_worker_threads[i].cpu_id == (int) cpu && !enabled[i])
+        { enabled[i] = 1; matched++; }
+  fclose (f);
+  if (!matched)
+    {
+      vec_free (enabled);
+      vec_free (policy);
+      return clib_error_return (0, "policy has no VPP packet threads");
+    }
+  snprintf (path, sizeof (path), "/sys/devices/system/cpu/cpufreq/%s/scaling_available_frequencies", policy);
+  f = fopen (path, "r");
+  if (f)
+    {
+      unsigned khz;
+      int supported = 0, idle_supported = 0;
+      while (fscanf (f, "%u", &khz) == 1)
+        { supported |= khz == boost; idle_supported |= khz == idle; }
+      fclose (f);
+      if (!supported || !idle_supported)
+        {
+          vec_free (enabled);
+          vec_free (policy);
+          return clib_error_return (0, "idle/boost is not an available frequency");
+        }
+    }
+  snprintf (path, sizeof (path), "/sys/devices/system/cpu/cpufreq/%s", policy);
+  vlib_worker_thread_barrier_sync (vm);
+  int err = dpdk_dvfs_start (path, idle, boost, enabled, n);
+  vlib_worker_thread_barrier_release (vm);
+  if (!err)
+    snprintf (selected_policy, sizeof (selected_policy), "%s", policy);
+  vec_free (enabled);
+  vec_free (policy);
+  if (err)
+    return clib_error_return (0, "start DVFS: %s", strerror (err));
+  return 0;
+}
+
+VLIB_CLI_COMMAND (dpdk_dvfs_set_command, static) = {
+  .path = "set dpdk dvfs",
+  .short_help = "set dpdk dvfs policy policyN idle <kHz> boost <kHz> | disable",
+  .function = dvfs_set,
+};
+
+static clib_error_t *
+dvfs_show (vlib_main_t *vm, unformat_input_t *input,
+           vlib_cli_command_t *cmd)
+{
+  (void) input;
+  (void) cmd;
+  dpdk_dvfs_stats_t s;
+  dpdk_dvfs_snapshot (&s);
+  vlib_cli_output (vm, "policy %s hold 100ms boosts %u releases %u failures %u active %d",
+                   selected_policy[0] ? selected_policy : "disabled",
+                   s.boosts, s.releases, s.failures, s.active);
+  vlib_cli_output (vm, "idle_khz %u boost_khz %u original_khz %u", s.idle_khz, s.boost_khz, s.original_khz);
+  vlib_cli_output (vm, "id trigger_ns wake_us write_begin_us write_end_us hold_us error");
+  unsigned begin = s.count > DPDK_DVFS_SAMPLES ? s.count - DPDK_DVFS_SAMPLES : 0;
+  for (unsigned i = begin; i < s.count; ++i)
+    {
+      dpdk_dvfs_sample_t *p = &s.samples[i % DPDK_DVFS_SAMPLES];
+      vlib_cli_output (vm, "%u %llu %.3f %.3f %.3f %.3f %d", i,
+                       (unsigned long long) p->trigger,
+                       (p->wake - p->trigger) / 1e3,
+                       (p->write_begin - p->trigger) / 1e3,
+                       (p->write_end - p->trigger) / 1e3,
+                       (p->released - p->latest) / 1e3,
+                       p->error);
+    }
+  return 0;
+}
+
+VLIB_CLI_COMMAND (dpdk_dvfs_show_command, static) = {
+  .path = "show dpdk dvfs",
+  .short_help = "show dpdk dvfs",
+  .function = dvfs_show,
+};
+
+static clib_error_t *
+dvfs_exit (vlib_main_t *vm)
+{
+  (void) vm;
+  int err = dpdk_dvfs_stop ();
+  return err ? clib_error_return (0, "restore DVFS floor: %s", strerror (err)) : 0;
+}
+VLIB_MAIN_LOOP_EXIT_FUNCTION (dvfs_exit);
