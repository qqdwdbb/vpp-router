+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef included_dpdk_dvfs_h
+#define included_dpdk_dvfs_h
+
+#include <errno.h>
+#include <stdint.h>
+#include <time.h>
+#include <unistd.h>
+
+#define DPDK_DVFS_HOLD_NS 100000000ULL
+#define DPDK_DVFS_PAIR_NS 1000000ULL
+#define DPDK_DVFS_SAMPLES 256
+
+/* One producer per slot; only last/first cross the controller boundary. */
+typedef struct
+{
+  _Alignas (64) uint64_t last;
+  uint64_t first;
+  uint64_t previous_small;
+  int enabled;
+} dpdk_dvfs_slot_t;
+
+typedef struct
+{
+  uint64_t trigger, latest, wake, write_begin, write_end, released;
+  int error;
+} dpdk_dvfs_sample_t;
+
+typedef struct
+{
+  unsigned count, boosts, releases, failures;
+  unsigned idle_khz, boost_khz, original_khz;
+  int active;
+  dpdk_dvfs_sample_t samples[DPDK_DVFS_SAMPLES];
+} dpdk_dvfs_stats_t;
+
+extern dpdk_dvfs_slot_t *dpdk_dvfs_slots;
+extern int dpdk_dvfs_event_fd;
+
+static inline uint64_t
+dpdk_dvfs_now (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (uint64_t) ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static inline void
+dpdk_dvfs_wake (void)
+{
+  uint64_t one = 1;
+  ssize_t result;
+  do
+    result = write (dpdk_dvfs_event_fd, &one, sizeof (one));
+  while (result < 0 && errno == EINTR);
+}
+
+/* No sysfs, allocation, lock or frequency wait on the packet thread. The
+ * nonblocking eventfd is written only at the start of a new busy episode. */
+static inline void
+dpdk_dvfs_rx_burst (unsigned thread, unsigned packets)
+{
+  dpdk_dvfs_slot_t *slots = dpdk_dvfs_slots;
+  if (__builtin_expect (slots == 0, 1) || !slots[thread].enabled)
+    return;
+  dpdk_dvfs_slot_t *s = slots + thread;
+  if (packets < 8)
+    {
+      s->previous_small = 0;
+      return;
+    }
+  uint64_t now = dpdk_dvfs_now ();
+  int request = packets >= 16 ||
+    (s->previous_small && now - s->previous_small <= DPDK_DVFS_PAIR_NS);
+  s->previous_small = now;
+  if (!request)
+    return;
+  uint64_t last = __atomic_load_n (&s->last, __ATOMIC_RELAXED);
+  int notify = last == 0 || now - last >= DPDK_DVFS_HOLD_NS;
+  if (notify)
+    __atomic_store_n (&s->first, now, __ATOMIC_RELAXED);
+  __atomic_store_n (&s->last, now, __ATOMIC_RELEASE);
+  if (notify)
+    {
+      /* EAGAIN means another pending wake already makes the fd readable. */
+      dpdk_dvfs_wake ();
+    }
+}
+
+/* Called with packet workers quiescent. start installs idle; stop restores
+ * the effective floor recorded before enable. */
+int dpdk_dvfs_start (const char *directory, unsigned idle_khz, unsigned boost_khz,
+                     const unsigned char *enabled, unsigned n_threads);
+int dpdk_dvfs_stop (void);
+void dpdk_dvfs_snapshot (dpdk_dvfs_stats_t *out);
+#endif
