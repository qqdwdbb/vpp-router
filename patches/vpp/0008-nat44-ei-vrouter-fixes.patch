+/* EI shares its pool receive route across outside ports in the same FIB.
+ * Pin the selected pool to its physical egress after configuring all egresses.
+ * This changes ARP/receive ownership, not the NAT allocator or sessions. */
+static clib_error_t *
+nat44_ei_pool_receive_command (vlib_main_t *vm, unformat_input_t *input,
+                             vlib_cli_command_t *cmd)
+{
+  nat44_ei_main_t *nm = &nat44_ei_main;
+  ip4_address_t address;
+  nat44_ei_address_t *pool_address;
+  nat44_ei_interface_t *interface;
+  u32 sw_if_index;
+  int found_address = 0, found_interface = 0;
+  if (!nm->enabled)
+    return clib_error_return (0, "NAT44 EI is disabled");
+  if (!unformat (input, "%U %U", unformat_ip4_address, &address,
+                 unformat_vnet_sw_interface, vnet_get_main (), &sw_if_index) ||
+      unformat_check_input (input) != UNFORMAT_END_OF_INPUT)
+    return clib_error_return (0, "Expected pool IPv4 address and outside interface");
+  vec_foreach (pool_address, nm->addresses)
+    if (pool_address->addr.as_u32 == address.as_u32)
+      found_address = 1;
+  pool_foreach (interface, nm->output_feature_interfaces)
+    if (interface->sw_if_index == sw_if_index &&
+        nat44_ei_interface_is_outside (interface))
+      found_interface = 1;
+  pool_foreach (interface, nm->interfaces)
+    if (interface->sw_if_index == sw_if_index &&
+        nat44_ei_interface_is_outside (interface))
+      found_interface = 1;
+  if (!found_address || !found_interface)
+    return clib_error_return (0, "Expected configured pool address and NAT outside interface");
+  nat44_ei_add_del_addr_to_fib (&address, 32, sw_if_index, 1);
+  return 0;
+}
+VLIB_CLI_COMMAND (nat44_ei_pool_receive_command_registration, static) = {
+  .path = "nat44 ei pool receive",
+  .short_help = "nat44 ei pool receive <pool-ip4> <outside-interface>",
+  .function = nat44_ei_pool_receive_command,
+};
