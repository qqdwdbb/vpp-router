vlib: close the frame-queue publish/sleep wakeup window

A producer can publish work after the consumer's initial work check but
before thread_sleeps is set. Pair publish/sleep fences and recheck work
after advertising sleep. Notify on every published frame, with the existing
wakeup_pending coalescing, instead of depending on queue empty transitions.
The fences run per frame, not per packet. Queue size and packet policy stay
unchanged.

--- a/src/vlib/file.c
+++ b/src/vlib/file.c
@@ -169,6 +169,15 @@
   /* at this point we know that thread is going to sleep, so let's annonce
    * to other threads that they need to wakeup us if they need our attention */
   __atomic_store_n (&vm->thread_sleeps, 1, __ATOMIC_RELAXED);
+
+  /* Pair with the frame-queue producer's publish-before-wakeup barrier.
+   * Work can arrive after the initial busy check but before we advertise
+   * sleep, so check it again before allowing epoll to block. */
+  __atomic_thread_fence (__ATOMIC_SEQ_CST);
+  if (vec_len (nm->pending_frames) ||
+      __atomic_load_n (&vm->check_frame_queues, __ATOMIC_ACQUIRE))
+    goto epoll;
+
 
   ticks = vlib_tw_timer_first_expires_in_ticks (vm);
 
