   .node_name = "nat44-ei-in2out",
   .runs_after = VNET_FEATURES ("acl-plugin-in-ip4-fa",
-			       "ip4-sv-reassembly-feature"),
+			       "ip4-sv-reassembly-feature",
+			       "dns-intercept-ip4",
+			       "abf-input-ip4"),
 };
 VNET_FEATURE_INIT (ip4_nat44_ei_out2in, static) = {
   .arc_name = "ip4-unicast",
@@ -109,7 +115,9 @@
