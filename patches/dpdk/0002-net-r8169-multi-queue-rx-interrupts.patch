net/r8169: RX interrupts for up to four queues

Keep the legacy EAL vector and forward it to per-queue eventfds.
Additional RX queues use the legacy 16-bit IMR/ISR bank. Wake every
armed queue because the receive path can clear status before the handler.

--- a/drivers/net/r8169/r8169_ethdev.c
+++ b/drivers/net/r8169/r8169_ethdev.c
@@ -161,12 +161,17 @@
 	struct rtl_adapter *adapter = container_of(hw, struct rtl_adapter, hw);
 	u32 mask = LinkChg;
 
-	if (adapter->rxq_intr_armed)
+	if (adapter->rxq_intr_armed[0])
 		mask |= RTL_RXQ_INTR_CAUSES;
 	if (rtl_is_8125(hw))
 		RTL_W32(hw, IMR0_8125, mask);
 	else
 		RTL_W16(hw, IntrMask, mask);
+	if (rtl_is_8125(hw))
+		for (unsigned int q = 1; q < adapter->rxq_intr_count; q++)
+			RTL_W16(hw, IMR1_8125 + (q - 1) * 4,
+				adapter->rxq_intr_armed[q] ? (BIT_0 | BIT_1) : 0);
+
 }
 
