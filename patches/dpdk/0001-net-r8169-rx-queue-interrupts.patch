 #include <rte_ethdev.h>
+#include <rte_spinlock.h>
 #include <rte_ethdev_core.h>
 
 #include "r8169_compat.h"
@@ -156,6 +157,16 @@ struct rtl_sw_stats {
 struct rtl_adapter {
 	struct rtl_hw       hw;
 	struct rtl_sw_stats sw_stats;
+
+	/*
+	 * RX queue interrupt, forwarded by the device interrupt handler to an
+	 * eventfd (see rtl_rxq_intr_setup()). intr_lock serialises IMR writes
+	 * between the interrupt thread and the threads that arm the queue.
+	 */
+	rte_spinlock_t      intr_lock;
+	bool                rxq_intr_on;    /* the eventfd exists */
+	bool                rxq_intr_armed; /* RX causes enabled in IMR */
+	int                 rxq_intr_efd;
 };
 
