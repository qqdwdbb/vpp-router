[Unit]
Description=VPP system settings: thread layout, RX modes and placement, NAT44-EI, CPU governors
# RX settings are put back after VPP restarts, which this watches for on its own, so it needs
# no ordering on VPP.

[Service]
ExecStart=/usr/local/bin/vpp-system --vpp-unit vpp-router.service
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
