[Unit]
Description=Nebula overlay network
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nebula -config /etc/nebula/config.yml
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
