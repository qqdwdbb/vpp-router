{
  "interval_seconds": 2,
  "monitor_resync_seconds": 60,
  "max_routes": 10000,
  "idle_seconds": 604800,
  "fib_audit_seconds": 60,
  "vpp_socket": "/run/vpp/cli.sock",
  "api_socket": "/run/vpp/api.sock",
  "vpp_service": "vpp",
  "state_file": "/var/lib/vpp-nft-route-sync/state.json",
  "lock_files": [
    "/run/lock/vpp-wireguard-client-import.lock",
    "/run/lock/vpp-wireguard-import.lock"
  ],
  "exclude_prefixes": ["10.64.20.3/32"],
  "mappings": [
    {
      "family": "inet",
      "table": "mangle",
      "set": "altroute",
      "interface": "wg1",
      "via": "10.62.30.1",
      "fib_table": 0
    },
    {
      "enabled": false,
      "family": "inet",
      "table": "mangle",
      "set": "vpn",
      "interface": "CHANGE_ME",
      "via": "CHANGE_ME",
      "fib_table": 0
    },
    {
      "enabled": false,
      "family": "inet",
      "table": "mangle",
      "set": "vpn6",
      "interface": "CHANGE_ME",
      "via": "CHANGE_ME",
      "fib_table": 0
    },
    {
      "enabled": false,
      "family": "inet",
      "table": "mangle",
      "set": "proxylist",
      "interface": "tap2080",
      "via": "10.63.50.2",
      "fib_table": 0
    },
    {
      "enabled": false,
      "family": "inet",
      "table": "mangle",
      "set": "proxylist6",
      "interface": "tap2080",
      "via": "fd76:7070:2080::2",
      "fib_table": 0
    }
  ]
}
