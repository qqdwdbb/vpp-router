[Unit]
Description=VPP transparent TCP/UDP to local SOCKS5
Requires=vpp-tproxy.service
After=vpp-tproxy.service
PartOf=vpp.service

[Service]
Type=simple
EnvironmentFile=/etc/default/ipt2socks-vpp
ExecStart=/usr/local/bin/ipt2socks -b 127.0.0.1 -B ::1 -l 2080 -s ${SOCKS_ADDR} -p ${SOCKS_PORT} -j ${THREADS}
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=vpp.service
