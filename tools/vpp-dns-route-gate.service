[Unit]
Description=Release DNS answers only after selected VPP routes are verified
Wants=vpp.service dnsmasq.service
After=vpp.service dnsmasq.service
PartOf=vpp.service
Conflicts=vpp-nft-route-sync.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nft -f /etc/vpp/dns-route-gate.nft
ExecStart=/usr/local/sbin/vpp-dns-route-gate --config /etc/vpp/dns-route-gate.json
Restart=on-failure
RestartSec=1
UMask=0077
StateDirectory=vpp-nft-route-sync
StateDirectoryMode=0700
RuntimeDirectory=vpp-nft-route-sync
RuntimeDirectoryMode=0700
# Keep redirect rules on failure: clients must not bypass a failed route barrier.

[Install]
WantedBy=multi-user.target vpp.service
