+	if ((consumed + 1) & (per_line - 1))
+		return;
+	if (!*count)
+		*first = consumed + 1 - per_line;
+	*count += per_line;
+	if (*count >= RTL_NC_REARM_LINES * per_line || consumed + 1 == rxq->nb_rx_desc) {
+		rtl_nc_rearm(rxq, *first, *count);
+		*count = 0;
+	}
