+bool
+rtl8125_rss_src_only(const struct rtl_hw *hw)
+{
+	return (hw->rss_hf & RTE_ETH_RSS_L3_SRC_ONLY) != 0;
+}
+
+u32
+rtl8125_rss_hf_to_ctrl(u64 rss_hf)
+{
+	u32 ctrl = 0;
+
+	if (!rss_hf)
+		return RTL_RSS_CTRL_OFFLOAD_ALL;
+
+	/* Ports and the destination must not reach the hash. */
+	if (rss_hf & RTE_ETH_RSS_L3_SRC_ONLY)
+		rss_hf &= RTL_RSS_L3_TYPES;
+
+	if (rss_hf & RTE_ETH_RSS_IPV4)
+		ctrl |= RSS_CTRL_IPV4_SUPP;
+	if (rss_hf & RTE_ETH_RSS_NONFRAG_IPV4_TCP)
+		ctrl |= RSS_CTRL_TCP_IPV4_SUPP;
+	if (rss_hf & RTE_ETH_RSS_NONFRAG_IPV6_TCP)
+		ctrl |= RSS_CTRL_TCP_IPV6_SUPP;
+	if (rss_hf & RTE_ETH_RSS_IPV6)
+		ctrl |= RSS_CTRL_IPV6_SUPP;
+	if (rss_hf & RTE_ETH_RSS_IPV6_EX)
+		ctrl |= RSS_CTRL_IPV6_EXT_SUPP;
+	if (rss_hf & RTE_ETH_RSS_IPV6_TCP_EX)
+		ctrl |= RSS_CTRL_TCP_IPV6_EXT_SUPP;
+	if (rss_hf & RTE_ETH_RSS_NONFRAG_IPV4_UDP)
+		ctrl |= RSS_CTRL_UDP_IPV4_SUPP;
+	if (rss_hf & RTE_ETH_RSS_NONFRAG_IPV6_UDP)
+		ctrl |= RSS_CTRL_UDP_IPV6_SUPP;
+	if (rss_hf & RTE_ETH_RSS_IPV6_UDP_EX)
+		ctrl |= RSS_CTRL_UDP_IPV6_EXT_SUPP;
+
+	return ctrl;
+}
+
+int
+rtl8125_rss_check(u64 rss_hf, u16 nb_rx_queues)
+{
+	if (!(rss_hf & RTE_ETH_RSS_L3_SRC_ONLY))
+		return 0;
+
+	if (!(rss_hf & RTL_RSS_L3_TYPES)) {
+		PMD_DRV_LOG(ERR, "l3-src-only needs ipv4 or ipv6 hashing");
+		return -EINVAL;
+	}
+
+	/* The table below reads two hash bits, so 3 queues cannot be even. */
+	if (nb_rx_queues != 1 && nb_rx_queues != 2 && nb_rx_queues != 4) {
+		PMD_DRV_LOG(ERR, "l3-src-only needs 1, 2 or 4 RX queues, not %u",
+			    nb_rx_queues);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void
+rtl_rss_key_clear_bits(u8 *key, int first, int last)
+{
+	int k;
+
+	for (k = first; k <= last; k++)
+		key[k / 8] &= ~(0x80 >> (k % 8));
+}
+
+/*
+ * Toeplitz XORs, for each set input bit j, the 32 key bits starting at
+ * key bit j; result bit b (0 = least significant) therefore takes key bit
+ * j + 31 - b. The destination address is input bits 32-63 for IPv4 and
+ * 128-255 for IPv6. Clearing key bits 61-93 and 157-285 keeps the
+ * destination out of result bits 1 and 2, and the default table maps
+ * queues from those two bits only. Bit 0 is not used: keeping it free of
+ * the destination would also cut the last source bit out of it.
+ */
+void
+rtl8125_rss_effective_key(const struct rtl_hw *hw, u8 *key)
+{
+	memcpy(key, hw->rss_key, RTL_RSS_KEY_SIZE);
+
+	if (!rtl8125_rss_src_only(hw))
+		return;
+
+	rtl_rss_key_clear_bits(key, 61, 93);
+	rtl_rss_key_clear_bits(key, 157, 285);
+
+	/*
+	 * The last IPv4 source byte reaches result bits 1 and 2 through key
+	 * bits 53-60 only; if they were all zero, hosts in one /24 would
+	 * share a queue. Bit 60 set keeps the two bits independent.
+	 */
+	key[60 / 8] |= 0x80 >> (60 % 8);
+}
+
+void
+rtl8125_rss_default_reta(struct rtl_hw *hw, u16 nb_rx_queues)
+{
+	int i;
+
+	for (i = 0; i < RTL_MAX_INDIRECTION_TABLE_ENTRIES; i++) {
+		if (rtl8125_rss_src_only(hw))
+			hw->rss_indir_tbl[i] = (u8)((i >> 1) & (nb_rx_queues - 1));
+		else
+			hw->rss_indir_tbl[i] = (u8)(i % nb_rx_queues);
+	}
+}
+
