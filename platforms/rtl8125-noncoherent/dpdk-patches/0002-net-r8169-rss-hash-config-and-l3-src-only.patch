-		rss_key |= hw->rss_key[i + 2] << 16;
-		rss_key |= hw->rss_key[i + 3] << 24;
+		rss_key = key[i];
+		rss_key |= key[i + 1] << 8;
+		rss_key |= key[i + 2] << 16;
+		rss_key |= key[i + 3] << 24;
 		RTL_W32(hw, RSS_KEY_8125 + i, rss_key);
 	}
 }
