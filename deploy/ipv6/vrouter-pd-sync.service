[Unit]
Description=Publish VPP delegated IPv6 prefixes and synchronize VPN pools
Requires=vpp.service
After=vpp.service
PartOf=vpp.service

[Service]
Type=simple
RuntimeDirectory=vrouter-pd-sync
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
Environment=PATH=/opt/vpp-nic1-test/vpp/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LD_LIBRARY_PATH=/opt/vpp-vrouter-migration/ipv6-pd/lib:/opt/vpp-nic1-test/dpdk/lib/aarch64-linux-gnu:/opt/vpp-nic1-test/vpp/lib/aarch64-linux-gnu
ExecStart=/usr/bin/python3 /opt/vpp-vrouter-migration/source/scripts/vrouter/ipv6/pd-sync.py --config /etc/vpp/vrouter-pd-sync.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=vpp.service
