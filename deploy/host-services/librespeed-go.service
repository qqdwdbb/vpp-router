[Unit]
Description=LibreSpeed Go backend
Requires=librespeed-go.socket
After=librespeed-go.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/speedtest-backend -c /etc/librespeed-go/settings.toml
User=nginx
Group=nginx
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
