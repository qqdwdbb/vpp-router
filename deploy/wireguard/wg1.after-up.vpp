set interface nat44 ei out wg1 output-feature
nat44 ei context wg1 loop101
nat44 ei add address 10.62.30.2 tenant-vrf 101
set interface tcp-mss-clamp wg1 ip4 enable ip4-mss 1240 ip6 disable
# The connected prefix has no glean adjacency on WireGuard.
ip route add 10.62.30.1/32 via 10.62.30.1 wg1
# Explicit production destinations; never install a table-0 VPN default route.
ip route add 10.65.0.0/16 via 10.62.30.1 wg1
ip route add 10.61.70.0/24 via 10.62.30.1 wg1
# EI registers each pool receive on the last outside, which wg1 has just become.
nat44 ei pool receive 10.61.50.3 loop10
